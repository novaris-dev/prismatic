{
	"name": "prismatic",
	"description": "Prismatic is a theme for the Novaris Content Management System, providing a clean and flexible starting point for your site.",
	"version": "1.0.0",
	"author": "Benjamin Lu",
	"license": "GPL-2.0-or-later",
	"homepage": "https://github.com/novaris-dev/prismatic#readme",
	"main": "resources/js/app.js",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/novaris-dev/prismatic.git"
	},
	"bugs": {
		"url": "https://github.com/novaris-dev/prismatic/issues"
	},
	"devDependencies": {
		"concurrently": "^10.0.5",
		"sass": "^1.93.3",
		"vite": "^7.2.1"
	},
	"scripts": {
		"build": "npm run prod && npm run export",
		"dev": "vite build --minify=false && concurrently \"npm:watch:vite\" \"npm:watch:novaris\"",
		"watch:vite": "vite build --watch --minify=false",
		"watch:novaris": "composer novaris export -- --watch",
		"prod": "vite build",
		"export": "node export-theme.js"
	}
}
